# ---------------------------------------------------------------------------
# Database (Neon in production, local PostgreSQL for development)
# ---------------------------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/scout_sfh?sslmode=require&pgbouncer=true"
# Direct connection string (used by Prisma migrations).
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/scout_sfh?sslmode=require"

# ---------------------------------------------------------------------------
# Auth and encryption
# ---------------------------------------------------------------------------
# Required. Signs admin sessions and participant cookies, and derives the
# AES-256-GCM key used for reflection answers. Changing it makes existing
# encrypted reflections unreadable. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site origin, used in certificate QR codes and verification links.
# No trailing slash. Example: https://sfh.scoutmoot2026.org
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seeded superadmin (used by `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ---------------------------------------------------------------------------
# Safeguarding contact shown on every page
# ---------------------------------------------------------------------------
SAFEGUARDING_CONTACT="Safeguarding focal point: safeguarding@example.org / +880 ..."

# ---------------------------------------------------------------------------
# Optional: Upstash Redis rate limiting
# ---------------------------------------------------------------------------
# Strongly recommended in production. Without these, rate limiting is
# per-instance in memory.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
